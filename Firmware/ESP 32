#include <WiFi.h>
#include <Wire.h>
#include <Adafruit_MLX90614.h>
#include <PubSubClient.h>
#include <Firebase_ESP_Client.h>
#include "addons/TokenHelper.h"
#include "addons/RTDBHelper.h"
#include <TridentTD_LineNotify.h>

// ========== WiFi Configuration ==========
const char* ssid = "YOUR_WIFI_SSID";
const char* password = "YOUR_WIFI_PASSWORD";

// ========== MQTT Configuration ==========
const char* mqtt_server = "broker.hivemq.com";  // หรือ Mosquitto ใน Local
const char* mqtt_topic = "smarthaven/sensor1";

// ========== LINE Notify Configuration ==========
#define LINE_TOKEN "YOUR_LINE_NOTIFY_TOKEN"

// ========== Firebase Configuration ==========
#define FIREBASE_HOST "https://YOUR_PROJECT.firebaseio.com/"
#define FIREBASE_AUTH "YOUR_FIREBASE_SECRET"

// ========== Pin Definitions ==========
#define MQ2_PIN        34    // ขา Analog สำหรับ MQ-2
#define BUZZER_PIN     25    // ขา Digital สำหรับ Buzzer
#define RELAY_PIN      26    // ขา Digital สำหรับ Relay (ควบคุมปั๊มโฟม)
#define FLAME_SENSOR   27    // ขา Digital สำหรับ Flame Sensor (ตรวจจับเปลวไฟ)

// ========== Threshold Settings ==========
#define SMOKE_THRESHOLD  500   // ค่า Analog ที่ถือว่าเกิน (0-4095)
#define TEMP_THRESHOLD   60.0  // อุณหภูมิที่ถือว่าอันตราย (°C)
#define DEBOUNCE_DELAY   3000  // หน่วงเวลา 3 วินาที ก่อนสั่งงานซ้ำ (ป้องกันการสั่งซ้ำบ่อยเกินไป)

// ========== Global Objects ==========
Adafruit_MLX90614 mlx = Adafruit_MLX90614();
WiFiClient espClient;
PubSubClient client(espClient);
FirebaseData fbdo;
FirebaseAuth auth;
FirebaseConfig config;

// ========== Global Variables ==========
unsigned long lastTriggerTime = 0;
bool alarmTriggered = false;

// ==========================================
// ฟังก์ชันอ่านค่าควันจาก MQ-2 พร้อม Moving Average Filter
// ==========================================
float readSmokeLevel() {
  const int numReadings = 10;
  long sum = 0;
  for (int i = 0; i < numReadings; i++) {
    sum += analogRead(MQ2_PIN);
    delay(10);
  }
  return sum / numReadings;
}

// ==========================================
// Dual-Sensing: ตรวจสอบสภาวะเพลิงไหม้
// ==========================================
bool isFireDetected(float smokeLevel, float ambientTemp, float objectTemp, bool flameDetected) {
  bool smokeDanger = (smokeLevel > SMOKE_THRESHOLD);
  bool tempDanger = (objectTemp > TEMP_THRESHOLD);
  
  // Dual-Verification: ต้องมีควัน หรือ (อุณหภูมิเกิน + ตรวจจับเปลวไฟ)
  return (smokeDanger && tempDanger) || (smokeDanger && flameDetected) || (tempDanger && flameDetected);
}

// ==========================================
// การทำงานเมื่อตรวจพบอัคคีภัย
// ==========================================
void activateFireSuppression() {
  if (!alarmTriggered) {
    alarmTriggered = true;
    lastTriggerTime = millis();
    
    Serial.println("⚠️ FIRE DETECTED! Activating suppression system...");
    
    // สั่งงานรีเลย์ (เปิดปั๊มโฟม)
    digitalWrite(RELAY_PIN, HIGH);
    Serial.println("RELAY: Suppression system ACTIVATED");
    
    // เปิดแจ้งเตือนด้วย Buzzer (เปิดค้างไว้ 5 วินาที แล้วปิด 5 วินาที - วนซ้ำ)
    digitalWrite(BUZZER_PIN, HIGH);
    
    // ส่งข้อความแจ้งเตือนผ่าน LINE
    LINE.notify("🔥 ระบบแจ้งเตือนเหตุเพลิงไหม้ 🔥\n"
                "📍 สถานะ: ตรวจพบควันและอุณหภูมิสูงเกินค่ามาตรฐาน\n"
                "🚒 ระบบดับเพลิงอัตโนมัติทำงานแล้ว กรุณาตรวจสอบพื้นที่\n"
                "#SmartHaven #FireAlert");
                
    Serial.println("LINE: Notification sent");
    
    // ส่งข้อความ MQTT แจ้งเตือน
    client.publish(mqtt_topic, "FIRE_DETECTED");
  }
}

// ==========================================
// ส่งข้อมูลไปยัง Firebase
// ==========================================
void sendToFirebase(float smoke, float ambientTemp, float objectTemp, bool flame, bool fireStatus) {
  if (Firebase.ready()) {
    // สร้าง JSON payload
    String jsonData = "{";
    jsonData += "\"smoke_level\":" + String(smoke) + ",";
    jsonData += "\"ambient_temp\":" + String(ambientTemp) + ",";
    jsonData += "\"object_temp\":" + String(objectTemp) + ",";
    jsonData += "\"flame_detected\":" + String(flame ? 1 : 0) + ",";
    jsonData += "\"fire_status\":" + String(fireStatus ? 1 : 0) + ",";
    jsonData += "\"timestamp\":" + String(millis());
    jsonData += "}";
    
    // ส่งไปยัง Firebase Realtime Database
    if (Firebase.RTDB.setJSON(&fbdo, "/sensors/latest", jsonData)) {
      Serial.println("Firebase: Data saved successfully");
    } else {
      Serial.print("Firebase error: ");
      Serial.println(fbdo.errorReason());
    }
  }
}

// ==========================================
// เชื่อมต่อและดูแล MQTT
// ==========================================
void reconnectMQTT() {
  while (!client.connected()) {
    Serial.print("Attempting MQTT connection...");
    if (client.connect("SmartHaven_ESP32")) {
      Serial.println("connected");
      client.publish(mqtt_topic, "ESP32 Online");
    } else {
      Serial.print("failed, rc=");
      Serial.print(client.state());
      Serial.println(" try again in 5 seconds");
      delay(5000);
    }
  }
}

// ==========================================
// เชื่อมต่อ WiFi
// ==========================================
void connectWiFi() {
  Serial.print("Connecting to WiFi");
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nWiFi connected");
  Serial.print("IP address: ");
  Serial.println(WiFi.localIP());
}

// ==========================================
// setup() - เริ่มต้นการทำงานของระบบ
// ==========================================
void setup() {
  Serial.begin(115200);
  delay(1000);
  
  Serial.println("\n=========================================");
  Serial.println("Smart Haven Fire Suppression System v1.0");
  Serial.println("=========================================");
  
  // กำหนดขา Input/Output
  pinMode(MQ2_PIN, INPUT);
  pinMode(FLAME_SENSOR, INPUT);
  pinMode(BUZZER_PIN, OUTPUT);
  pinMode(RELAY_PIN, OUTPUT);
  
  // เริ่มต้นให้รีเลย์และบัซเซอร์ปิดอยู่
  digitalWrite(RELAY_PIN, LOW);
  digitalWrite(BUZZER_PIN, LOW);
  
  // เชื่อมต่อ WiFi
  connectWiFi();
  
  // เชื่อมต่อ MQTT
  client.setServer(mqtt_server, 1883);
  reconnectMQTT();
  
  // เริ่มต้นเซ็นเซอร์วัดอุณหภูมิ MLX90614
  if (!mlx.begin()) {
    Serial.println("Error: MLX90614 not found!");
  } else {
    Serial.println("MLX90614 initialized");
  }
  
  // เริ่มต้น LINE Notify
  LINE.setToken(LINE_TOKEN);
  Serial.println("LINE Notify initialized");
  
  // เริ่มต้น Firebase
  config.database_url = FIREBASE_HOST;
  config.signer.tokens.legacy_token = FIREBASE_AUTH;
  Firebase.begin(&config, &auth);
  Firebase.reconnectWiFi(true);
  Serial.println("Firebase initialized");
  
  // Warm-up sensor MQ-2 (20 วินาที)
  Serial.println("MQ-2 sensor warming up...");
  delay(20000);
  Serial.println("System ready!");
}

// ==========================================
// loop() - ทำงานหลักของระบบแบบวนซ้ำ
// ==========================================
void loop() {
  // ตรวจสอบการเชื่อมต่อ MQTT และ Firebase
  if (!client.connected()) {
    reconnectMQTT();
  }
  client.loop();
  
  // ----- อ่านค่าจากเซ็นเซอร์ -----
  float smokeLevel = readSmokeLevel();
  float ambientTemp = mlx.readAmbientTempC();
  float objectTemp = mlx.readObjectTempC();
  bool flameDetected = (digitalRead(FLAME_SENSOR) == HIGH);
  
  // ----- แสดงผลทาง Serial Monitor -----
  Serial.println("\n--- Sensor Reading ---");
  Serial.print("Smoke Level (MQ-2): ");
  Serial.print(smokeLevel);
  Serial.print(" | Threshold: ");
  Serial.println(SMOKE_THRESHOLD);
  
  Serial.print("Ambient Temp: ");
  Serial.print(ambientTemp);
  Serial.println(" °C");
  
  Serial.print("Object Temp: ");
  Serial.print(objectTemp);
  Serial.println(" °C");
  
  Serial.print("Flame Detected: ");
  Serial.println(flameDetected ? "YES" : "NO");
  
  // ----- Dual-Sensing Verification -----
  bool fireDetected = isFireDetected(smokeLevel, ambientTemp, objectTemp, flameDetected);
  
  Serial.print("Fire Status: ");
  Serial.println(fireDetected ? "⚠️ DANGER" : "✅ SAFE");
  
  // ----- ส่งข้อมูลขึ้น Firebase -----
  sendToFirebase(smokeLevel, ambientTemp, objectTemp, flameDetected, fireDetected);
  
  // ----- ส่งข้อความ MQTT (ข้อมูลทั่วไป) -----
  char mqttMsg[100];
  sprintf(mqttMsg, "{\"smoke\":%.0f,\"temp\":%.1f,\"flame\":%d}",
          smokeLevel, objectTemp, flameDetected);
  client.publish(mqtt_topic, mqttMsg);
  
  // ----- ตรวจจับและจัดการเพลิงไหม้ -----
  if (fireDetected) {
    activateFireSuppression();
  } else {
    // ถ้าปลอดภัย รีเซ็ตสถานะ (และปิดการแจ้งเตือนหากครบรอบ)
    if (alarmTriggered && (millis() - lastTriggerTime > 20000)) {
      alarmTriggered = false;
      digitalWrite(RELAY_PIN, LOW);
      digitalWrite(BUZZER_PIN, LOW);
      Serial.println("System reset: All clear!");
      
      // ส่งข้อความ MQTT บอกสถานการณ์คลี่คลาย
      client.publish(mqtt_topic, "ALL_CLEAR");
      
      // ส่ง LINE แจ้งเตือนสถานการณ์กลับสู่ปกติ
      LINE.notify("✅ ระบบ Smart Haven: สถานการณ์กลับสู่ปกติแล้ว ✅\n"
                  "📍 ไม่พบควันและอุณหภูมิที่ผิดปกติ\n"
                  "#SmartHaven #AllClear");
    } else if (!alarmTriggered) {
      // ถ้าปกติทุกอย่าง ให้รีเลย์และบัซเซอร์ปิดอยู่
      digitalWrite(RELAY_PIN, LOW);
      digitalWrite(BUZZER_PIN, LOW);
    }
  }
  
  // หน่วงเวลา 2 วินาทีก่อนรอบถัดไป
  delay(2000);
}
