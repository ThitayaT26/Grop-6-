/**
  * @brief ตั้งค่า ADC1 สำหรับ Flame Sensor (Channel 0)
  */
static void MX_ADC1_Init(void)
{
    ADC_ChannelConfTypeDef sConfig = {0};
    
    hadc1.Instance = ADC1;
    hadc1.Init.ClockPrescaler = ADC_CLOCK_SYNC_PCLK_DIV2;
    hadc1.Init.Resolution = ADC_RESOLUTION_12B;
    hadc1.Init.DataAlign = ADC_DATAALIGN_RIGHT;
    hadc1.Init.ScanConvMode = ADC_SCAN_SEQ_FIXED;
    hadc1.Init.EOCSelection = ADC_EOC_SINGLE_CONV;
    hadc1.Init.LowPowerAutoWait = DISABLE;
    hadc1.Init.ContinuousConvMode = DISABLE;
    hadc1.Init.NbrOfConversion = 1;
    hadc1.Init.DiscontinuousConvMode = DISABLE;
    hadc1.Init.ExternalTrigConv = ADC_SOFTWARE_START;
    hadc1.Init.ExternalTrigConvEdge = ADC_EXTERNALTRIGCONVEDGE_NONE;
    hadc1.Init.SamplingTimeCommon1 = ADC_SAMPLETIME_39CYCLES_5;
    
    if (HAL_ADC_Init(&hadc1) != HAL_OK) {
        Error_Handler();
    }
    
    sConfig.Channel = ADC_CHANNEL_0;
    sConfig.Rank = ADC_RANK_CHANNEL_NUMBER;
    if (HAL_ADC_ConfigChannel(&hadc1, &sConfig) != HAL_OK) {
        Error_Handler();
    }
}

/**
  * @brief ตั้งค่า ADC2 สำหรับ Smoke Sensor (Channel 1)
  */
static void MX_ADC2_Init(void)
{
    ADC_ChannelConfTypeDef sConfig = {0};
    
    hadc2.Instance = ADC1;  /* ใช้ ADC1 เหมือนกัน แต่คนละ Channel */
    hadc2.Init = hadc1.Init;  /* Copy config */
    
    if (HAL_ADC_Init(&hadc2) != HAL_OK) {
        Error_Handler();
    }
    
    sConfig.Channel = ADC_CHANNEL_1;
    sConfig.Rank = ADC_RANK_CHANNEL_NUMBER;
    if (HAL_ADC_ConfigChannel(&hadc2, &sConfig) != HAL_OK) {
        Error_Handler();
    }
}

/**
  * @brief ตั้งค่า GPIO
  */
static void MX_GPIO_Init(void)
{
    GPIO_InitTypeDef GPIO_InitStruct = {0};
    
    /* Enable clocks */
    __HAL_RCC_GPIOA_CLK_ENABLE();
    __HAL_RCC_GPIOB_CLK_ENABLE();
    
    /* ตั้งค่า LED และ Buzzer */
    GPIO_InitStruct.Pin = LED_RED_PIN | LED_YELLOW_PIN | LED_GREEN_PIN | BUZZER_PIN;
    GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_PP;
    GPIO_InitStruct.Pull = GPIO_NOPULL;
    GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_LOW;
    HAL_GPIO_Init(GPIOA, &GPIO_InitStruct);
    
    /* เริ่มต้นทั้งหมดเป็น LOW */
    HAL_GPIO_WritePin(GPIOA, LED_RED_PIN | LED_YELLOW_PIN | LED_GREEN_PIN | BUZZER_PIN, 
                      GPIO_PIN_RESET);
}

/**
  * @brief Error handler
  */
void Error_Handler(void)
{
    __disable_irq();
    while (1) {
        /* Blink all LEDs to indicate error */
        HAL_GPIO_TogglePin(GPIOA, LED_RED_PIN | LED_YELLOW_PIN | LED_GREEN_PIN);
        HAL_Delay(100);
    }
}

